# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# AI tool configs (personal)
.codex/
.gemini/
.opencode/
.agents/

# Same for .claude/, except the project automations that belong to the release
# process: they are maintenance tooling like docs/release.md and are meant to be
# shared. Note the contents are excluded rather than the directory itself: git
# does not descend into an excluded directory, so a `!` rule under `.claude/`
# would never take effect.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/skills/*
!.claude/skills/
!.claude/skills/release/

# Internal working notes
tasks/
tmp/
tmp.md

# Caches
.pytest_cache/
.ruff_cache/

# Reference material (e.g. third-party manuals, not for redistribution)
ref/

# Local video material (keep only the published demo video)
video/*
!video/openverto-demo-v2.mp4
